{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dash",
  "version": "1.0.0",
  "identifier": "com.antwnakys.dash",
  "build": {
    "frontendDist": "launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dash",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.productivity",
    "shortDescription": "Courses, deadlines, tasks, calendar and weather",
    "copyright": "Antonis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.googleusercontent.apps.349920744170-qjt1nfonl3hvqvdfnr9j8qkgp23k3jo5"]
      }
    }
  }
}
